        "surface": "struct SurfaceData {\n    vec3 baseColor;\n    float metallic;\n    float smoothness;\n    vec3 normal;\n    vec3 emission;\n    vec3 bakedLight;   // baked light multiplier; 1 when no bake is connected\n    float alpha;\n    float clearCoat;            // 0 = none (clear-coat layer strength)\n    float clearCoatSmoothness;  // clear-coat highlight sharpness\n    vec3 toonShade;     // Toon Master: shade colour in the shadow band\n    float toonThreshold;// Toon Master: N.L where the band starts\n    float toonSoftness; // Toon Master: width of the band edge\n    vec3 toonRamp;      // NPR Master: ramp atlas colour, multiplied into the shade\n    float toonOcclusion;// NPR Master: ambient occlusion (ILM green, vertex colour red)\n    float toonShadow;   // NPR Master: 1 where the sun is visible\n    float toonScene;    // NPR Master: 0 = no sun or sky term, the ramp carries the light\n    float toonRampBlend;// NPR Master: how strongly the ramp tone replaces the lit tone\n    float toonWrap;     // NPR Master: 0 = N.L terminator, 1 = half-Lambert\n    float toonMask;     // NPR Master: replaces the ramp (painted style ramp, ILM mask)\n    float toonMaskMix;  // NPR Master: how far toonMask replaces the ramp\n    float toonFloor;    // NPR Master: albedo floor kept in the shadow\n    float toonAmbient;  // NPR Master: hemisphere ambient strength\n    float toonBoost;    // NPR Master: multiplies the lit term\n    float toonNormalShade; // NPR Master: 0.92..1.08 lit modulation by the wrap\n    vec3 toonRim;       // Face Master: additive rim light\n    float toon;         // 1 = NPR (Toon) Master lighting\n    float sdfShadow;    // Hybrid/Face: 0 = lit, 1 = shadowed\n    float specMask;     // Hybrid: specular mask\n    vec3 hairSpecular;  // Hybrid: anisotropic hair\n    vec3 matcap;        // Hybrid: matcap reflection\n    float wetness;      // Hybrid: rain coverage\n    float hybrid;       // 1 = Hybrid Master lighting\n    float face;         // 1 = Face Master lighting\n    float lit;   // 1 = shaded by the frame's sun and sky, 0 = unlit\n};\n\nSurfaceData ukiyo_surface(vec2 uv, vec3 normal) {\n    SurfaceData s;\n    s.baseColor = vec3(1.0);\n    s.metallic = 0.0;\n    s.smoothness = 0.5;\n    s.normal = normal;\n    s.emission = vec3(0.0);\n    s.bakedLight = vec3(1.0);\n    s.alpha = 1.0;\n    s.clearCoat = 0.0;\n    s.clearCoatSmoothness = 0.5;\n    s.toonShade = vec3(0.6, 0.5, 0.6);\n    s.toonThreshold = 0.0;\n    s.toonSoftness = 0.05;\n    s.toonRamp = vec3(1.0);\n    s.toonOcclusion = 1.0;\n    s.toonShadow = 1.0;\n    s.toonScene = 1.0;\n    s.toonRampBlend = 1.0;\n    s.toonWrap = 0.0;\n    s.toonMask = 0.0;\n    s.toonMaskMix = 0.0;\n    s.toonFloor = 0.0;\n    s.toonAmbient = 0.55;\n    s.toonBoost = 1.0;\n    s.toonNormalShade = 0.0;\n    s.toonRim = vec3(0.0);\n    s.toon = 0.0;\n    s.sdfShadow = 0.0;\n    s.specMask = 1.0;\n    s.hairSpecular = vec3(0.0);\n    s.matcap = vec3(0.0);\n    s.wetness = 0.0;\n    s.hybrid = 0.0;\n    s.face = 0.0;\n    s.lit = 1.0;\n    vec3 n1_0 = texture(texn1, uv).rgb;\n    float n1_1 = texture(texn1, uv).a;\n    vec3 n2_0 = p0.xyz;\n    vec3 n3_0 = n1_0 * n2_0;\n    vec3 n4_0 = p1.xyz;\n    vec3 n5_0 = vec3(1.0, 1.0, 1.0);\n    vec3 n6_0 = normalize(normal);\n    vec3 n7_0 = normalize(frame.sunDir.xyz);\n    float n8_0 = dot(n6_0, n7_0);\n    float n9_0 = -1.0;\n    float n10_0 = 1.0;\n    float n11_0 = 0.0;\n    float n12_0 = 1.0;\n    float n13_0 = mix(n11_0, n12_0, clamp((n8_0 - n9_0) / max(abs(n10_0 - n9_0), 1e-5), 0.0, 1.0));\n    float n14_0 = p2.x;\n    float n15_0 = p3.x;\n    float n16_0 = ukiyo_cel_bands(n13_0, n14_0, n15_0);\n    vec3 n17_0 = mix(n4_0, n5_0, n16_0);\n    vec3 n18_0 = n3_0 * n17_0;\n    vec3 n19_0 = frame.sunColor.rgb;\n    float n20_0 = 0.8;\n    vec3 n21_0 = n19_0 * n20_0;\n    vec3 n22_0 = mix(frame.groundColor.rgb, frame.skyColor.rgb, 0.5 + 0.5 * normalize(normal).y);\n    float n23_0 = 0.25;\n    vec3 n24_0 = n22_0 * n23_0;\n    vec3 n25_0 = n21_0 + n24_0;\n    vec3 n26_0 = n18_0 * n25_0;\n    float n27_0 = p4.x;\n    float n28_0 = p5.x;\n    float n29_0 = ukiyo_scanlines(n27_0, n28_0);\n    float n30_0 = p6.x;\n    float n31_0 = n29_0 * n30_0;\n    float n32_0 = 1.0;\n    float n33_0 = n32_0 - n30_0;\n    float n34_0 = n31_0 + n33_0;\n    vec3 n35_0 = vec3(n34_0, n34_0, n34_0);\n    vec3 n36_0 = n26_0 * n35_0;\n    vec3 n37_0 = p7.xyz;\n    vec2 n38_0 = uv;\n    float n39_0 = p8.x;\n    float n40_0 = p9.x;\n    vec2 n41_0 = uv;\n    float n42_0 = n41_0.x;\n    float n42_1 = n41_0.y;\n    float n43_0 = p10.x;\n    float n44_0 = n42_0 * n43_0;\n    float n45_0 = fract(n44_0);\n    float n46_0 = ukiyo_hatch(n38_0, n39_0, n40_0, n45_0);\n    vec2 n47_0 = uv;\n    float n48_0 = p8.x;\n    float n49_0 = p9.x;\n    vec2 n50_0 = uv;\n    float n51_0 = n50_0.x;\n    float n51_1 = n50_0.y;\n    float n52_0 = p10.x;\n    float n53_0 = n51_1 * n52_0;\n    float n54_0 = fract(n53_0);\n    float n55_0 = ukiyo_hatch(n47_0, n48_0, n49_0, n54_0);\n    float n56_0 = n46_0 + n55_0;\n    float n57_0 = clamp(n56_0, 0.0, 1.0);\n    float n58_0 = p11.x;\n    float n59_0 = n57_0 * n58_0;\n    vec3 n60_0 = n37_0 * n59_0;\n    vec3 n61_0 = p12.xyz;\n    float n62_0 = p13.x;\n    float n63_0 = pow(1.0 - clamp(dot(normalize(normal), normalize(frame.camPos.xyz - v_world)), 0.0, 1.0), max(n62_0, 0.0001));\n    float n64_0 = p14.x;\n    float n65_0 = n63_0 * n64_0;\n    vec3 n66_0 = n61_0 * n65_0;\n    vec3 n67_0 = n60_0 + n66_0;\n    vec3 n68_0 = n36_0 + n67_0;\n    s.baseColor = n68_0;\n    s.alpha = 1.0;\n    s.lit = 0.0;\n    return s;\n}\n",
