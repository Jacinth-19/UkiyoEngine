    "ok": true,
    "fragment": "#version 450\n// Generated by tools/endfield/build_endfield.py from NahidaFace.body.glsl. Edit the body file, then re-run.\nlayout(location = 0) in vec2 v_uv;\nlayout(location = 1) in vec3 v_normal;\nlayout(location = 2) in vec3 v_world;\nlayout(location = 3) in vec4 v_color;\nlayout(location = 4) in vec2 v_uv1;\nlayout(location = 0) out vec4 o_color;\nlayout(set = 0, binding = 0, std140) uniform FrameBlock {\n    mat4 view;\n    mat4 proj;\n    mat4 viewProj;\n    mat4 invViewProj;\n    mat4 shadowMatrix[3];\n    vec4 camPos;\n    vec4 sunDir;\n    vec4 sunColor;\n    vec4 skyColor;\n    vec4 groundColor;\n    vec4 cascadeSplits;\n    vec4 shadowParams;\n    vec4 screenParams;\n    vec4 pointPos[4];\n    vec4 pointColor[4];\n    vec4 toonA;\n    vec4 toonB;\n    vec4 toonC;\n    vec4 toonD;\n    vec4 toonE;\n    vec4 toonF;\n    vec4 toonG;\n    vec4 toonH;\n    vec4 toonI;\n    vec4 waterArea;\n    vec4 waterHalf;\n    vec4 waterShallow;\n    vec4 waterDeep;\n    vec4 waterWaveD[4];\n    vec4 waterWaveS[4];\n} frame;\nlayout(set = 0, binding = 1) uniform sampler2D uShadowMap;\n\nlayout(set = 1, binding = 15, std140) uniform UkMaterial {\n    vec4 p0; // outlineColor (vec3)\n    vec4 p1; // outlineWidth (float)\n    vec4 p2; // outlineAlpha (float)\n    vec4 p3; // baseTexFac (float)\n    vec4 p4; // toonTexFac (float)\n    vec4 p5; // ambientColor (vec3)\n    vec4 p6; // diffuseColor (vec3)\n    vec4 p7; // shadowColor (vec3)\n    vec4 p8; // outlineDistance (vec2)\n    vec4 p9; // outlineWidthFactors (vec2)\n    vec4 p10; // outlineScreenOffset (vec2)\n    vec4 p11; // outlineZOffset (float)\n    vec4 p12; // outlineVertexAlpha (float)\n    vec4 p13; // outlineSmoothNormal (float)\n    vec4 p14; // outlineViewDirection (float)\n    vec4 p15; // faceRampRow (float)\n    vec4 p16; // forwardVector (vec3)\n    vec4 p17; // rightVector (vec3)\n    vec4 p18; // rimColor (vec3)\n    vec4 p19; // rimPower (float)\n    vec4 p20; // rimIntensity (float)\n    vec4 p21; // alpha (float)\n    vec4 p22; // alphaClip (float)\n    vec4 p23; // faceBlushColor (vec3)\n    vec4 p24; // faceBlushStrength (float)\n    vec4 p25; // faceShadowOffset (float)\n    vec4 p26; // faceShadowSoftness (float)\n    vec4 p27; // dayOverride (float)\n    vec4 p28; // lightDirMul (vec3)\n    vec4 p29; // useBackUV (float)\n};\n\n#define P_outlineColor p0.rgb\n#define P_outlineWidth p1.x\n#define P_outlineAlpha p2.x\n#define P_baseTexFac p3.x\n#define P_toonTexFac p4.x\n#define P_ambientColor p5.rgb\n#define P_diffuseColor p6.rgb\n#define P_shadowColor p7.rgb\n#define P_outlineDistance p8.xy\n#define P_outlineWidthFactors p9.xy\n#define P_outlineScreenOffset p10.xy\n#define P_outlineZOffset p11.x\n#define P_outlineVertexAlpha p12.x\n#define P_outlineSmoothNormal p13.x\n#define P_outlineViewDirection p14.x\n#define P_faceRampRow p15.x\n#define P_forwardVector p16.rgb\n#define P_rightVector p17.rgb\n#define P_rimColor p18.rgb\n#define P_rimPower p19.x\n#define P_rimIntensity p20.x\n#define P_alpha p21.x\n#define P_alphaClip p22.x\n#define P_faceBlushColor p23.rgb\n#define P_faceBlushStrength p24.x\n#define P_faceShadowOffset p25.x\n#define P_faceShadowSoftness p26.x\n#define P_dayOverride p27.x\n#define P_lightDirMul p28.rgb\n#define P_useBackUV p29.x\n\nlayout(set = 1, binding = 0) uniform sampler2D tex_base;\nlayout(set = 1, binding = 1) uniform sampler2D tex_normalStyle;\nlayout(set = 1, binding = 2) uniform sampler2D tex_param;\nlayout(set = 1, binding = 3) uniform sampler2D tex_maskFlow;\nlayout(set = 1, binding = 4) uniform sampler2D tex_faceSdf;\nlayout(set = 1, binding = 5) uniform sampler2D tex_emission;\nlayout(set = 1, binding = 6) uniform sampler2D tex_highlightHair;\nlayout(set = 1, binding = 7) uniform sampler2D tex_lookup;\n\nconst float ATLAS_SIZE = 256.0;\nconst vec4 REGION_RAMP = vec4(0.0, 0.0, 256.0, 20.0);\nconst vec4 REGION_SPEC = vec4(0.0, 20.0, 256.0, 16.0);\nconst vec4 REGION_LUT = vec4(0.0, 36.0, 256.0, 16.0);\nconst vec4 REGION_MATCAP = vec4(0.0, 52.0, 128.0, 128.0);\n// Samples a lookup region of the atlas at (uv in 0..1), inset by half a texel, LOD 0.\nvec3 atlasSample(vec4 region, vec2 uv) {\n    vec2 px = region.xy + 0.5 + clamp(uv, 0.0, 1.0) * (region.zw - 1.0);\n    return textureLod(tex_lookup, px / ATLAS_SIZE, 0.0).rgb;\n}\n\n\nfloat shadowFactor(vec3 worldPos, vec3 N) {\n    if (frame.shadowParams.x < 0.5) return 1.0;\n    vec3 L = normalize(frame.sunDir.xyz);\n    float viewDist = -(frame.view * vec4(worldPos, 1.0)).z;\n    int cascade = -1;\n    if (viewDist < frame.cascadeSplits.x) cascade = 0;\n    else if (viewDist < frame.cascadeSplits.y) cascade = 1;\n    else if (viewDist < frame.cascadeSplits.z) cascade = 2;\n    if (cascade < 0) return 1.0;\n    float ndl = clamp(dot(N, L), 0.0, 1.0);\n    vec3 p = worldPos + N * frame.shadowParams.z * (1.0 - ndl);\n    vec4 lp = frame.shadowMatrix[cascade] * vec4(p, 1.0);\n    vec3 sc = lp.xyz / lp.w;\n    vec2 uv = sc.xy * 0.5 + 0.5;\n    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return 1.0;\n    vec2 quad = vec2(float(cascade % 2), float(cascade / 2)) * 0.5;\n    uv = clamp(quad + uv * 0.5, quad + vec2(0.001), quad + vec2(0.499));\n    float texel = frame.shadowParams.y;\n    float z = sc.z - frame.shadowParams.w;\n    vec4 g0 = textureGather(uShadowMap, uv + vec2(-0.5, -0.5) * texel);\n    vec4 g1 = textureGather(uShadowMap, uv + vec2( 0.5, -0.5) * texel);\n    vec4 g2 = textureGather(uShadowMap, uv + vec2(-0.5,  0.5) * texel);\n    vec4 g3 = textureGather(uShadowMap, uv + vec2( 0.5,  0.5) * texel);\n    float lit = dot(step(vec4(z), g0), vec4(1.0)) + dot(step(vec4(z), g1), vec4(1.0))\n              + dot(step(vec4(z), g2), vec4(1.0)) + dot(step(vec4(z), g3), vec4(1.0));\n    return lit / 16.0;\n}\n\n\n// Nahida face (Face.shader's logic, our own GLSL). Used by NahidaFace.ukmat only.\n// Packed inputs: base = face diffuse; faceSdf = FaceLightmap (R: SDF threshold, G: shadow strength,\n// A: forced-light mask; the source's _SDF and _ShadowTex are the same texture); lookup = face shadow ramp\n// (region RAMP) and the toon matcap (region MATCAP). Face has no normal map.\n// Head direction: frame.toonD (as the Endfield face path) when set, else the material's forward and right.\n\nvoid main() {\n    vec2 uv = (P_useBackUV > 0.5 && !gl_FrontFacing) ? v_uv1 : v_uv;   // back faces read TEXCOORD_1 when on\n    vec4 baseTex = texture(tex_base, uv);\n    // Blush (Kaze): lerp the base colour towards the blush colour by the strength and the base texture's alpha.\n    float blushMask = clamp(P_faceBlushStrength * baseTex.a, 0.0, 1.0);\n    vec3 baseRgb = mix(baseTex.rgb, P_faceBlushColor, blushMask);\n    vec3 N = normalize(v_normal);\n    vec3 V = normalize(frame.camPos.xyz - v_world);\n    vec3 L = normalize(frame.sunDir.xyz * P_lightDirMul);\n    float NoV = clamp(dot(N, V), 0.0, 1.0);\n\n    // Base colour: ambient lerped towards ambient + diffuse, then the base and toon (matcap) textures.\n    vec3 baseColor = clamp(mix(P_ambientColor, P_ambientColor + P_diffuseColor, 0.6), 0.0, 1.0);\n    baseColor = mix(baseColor, baseColor * baseRgb, P_baseTexFac);\n    vec3 nVS = (frame.view * vec4(N, 0.0)).xyz;\n    vec3 toonTex = atlasSample(REGION_MATCAP, nVS.xy * 0.5 + 0.5);\n    baseColor = mix(baseColor, baseColor * toonTex, P_toonTexFac);\n\n    // Shadow ramp: row faceRampRow at U = 0.003. The night row is the day row + 0.5. Day/night by the light's Y.\n    float rampV = P_faceRampRow / 10.0 - 0.05;\n    // dayOverride < 0 follows the sun; 0..1 forces night..day.\n    float isDay = P_dayOverride < 0.0 ? (L.y + 1.0) * 0.5 : clamp(P_dayOverride, 0.0, 1.0);\n    vec3 rampColor = mix(atlasSample(REGION_RAMP, vec2(0.003, rampV + 0.5)),\n                         atlasSample(REGION_RAMP, vec2(0.003, rampV)), isDay);\n\n    // SDF face shadow. Project the light onto the head's horizontal plane, then compare the light's angle\n    // from the head's right vector with the SDF threshold, sampled from the side the light is on.\n    bool fromFrame = frame.toonD.z > 0.5;\n    vec3 fwd = fromFrame ? vec3(frame.toonD.x, 0.0, frame.toonD.y) : P_forwardVector;\n    vec3 right = fromFrame ? cross(vec3(0.0, 1.0, 0.0), fwd) : P_rightVector;\n    float sdf = 1.0;\n    vec3 up = cross(fwd, right);\n    float upLen2 = dot(up, up);\n    if (upLen2 > 1e-12) {\n        vec3 lightOnHead = L - dot(L, up) / upLen2 * up;\n        float lightLen = length(lightOnHead);\n        if (lightLen > 1e-5) {\n            vec3 ld = lightOnHead / lightLen;\n            float angle01 = acos(clamp(dot(ld, normalize(right)), -1.0, 1.0)) / 3.14159265;\n            float exposeRight = step(angle01, 0.5);\n            float valueR = pow(clamp(1.0 - angle01 * 2.0, 0.0, 1.0), 3.0);\n            float valueL = pow(clamp(angle01 * 2.0 - 1.0, 0.0, 1.0), 3.0);\n            float mixValue = mix(valueL, valueR, exposeRight);\n            float sdfLeft = texture(tex_faceSdf, vec2(1.0 - uv.x, uv.y)).r;\n            float sdfRight = texture(tex_faceSdf, uv).r;\n            float mixSdf = mix(sdfRight, sdfLeft, exposeRight);\n            // Softness 0 is a hard edge; above 0 the edge is smoothed over 0.05 * softness either side of the offset threshold.\n            float edgeW = P_faceShadowSoftness * 0.05;\n            float thr = mixValue + P_faceShadowOffset;\n            float sdfRaw = edgeW > 0.0 ? smoothstep(thr - edgeW, thr + edgeW, mixSdf) : step(thr, mixSdf);\n            // Light behind the head: fully lit.\n            sdf = mix(1.0, sdfRaw, step(0.0, dot(ld, normalize(fwd))));\n            vec4 shadowTex = texture(tex_faceSdf, uv);\n            sdf *= shadowTex.g;\n            sdf = mix(sdf, 1.0, shadowTex.a);\n        }\n    }\n\n    vec3 shadowColor = baseColor * rampColor * P_shadowColor;\n    vec3 diffuse = mix(shadowColor, baseColor, sdf);\n    float fresnel = pow(1.0 - NoV, P_rimPower);\n    diffuse += fresnel * P_rimIntensity * P_rimColor;\n\n    float alpha = P_alpha * baseTex.a;\n    if (alpha < P_alphaClip) discard;\n    o_color = vec4(diffuse, alpha);\n}\n",
