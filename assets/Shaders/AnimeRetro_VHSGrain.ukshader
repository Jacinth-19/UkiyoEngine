// scanlineHeight (float)\n    vec4 p10; // scanlineSpeed (float)\n    vec4 p11; // scanlineStrength (float)\n};\nlayout(set = 1, binding = 0) uniform sampler2D texn1;\nvec3 ukiyo_hue_rotate(vec3 c, float degrees) {\n    float a = radians(degrees);\n    float co = cos(a);\n    float si = sin(a);\n    vec3 k = vec3(0.57735027);   // the grey axis, normalised\n    // Rodrigues' rotation around the grey axis: luma is kept, the hue turns.\n    return c * co + cross(k, c) * si + k * dot(k, c) * (1.0 - co);\n}\nfloat ukiyo_cel_bands(float light, float bands, float softness) {\n    float n = max(bands, 2.0);\n    float t = clamp(light, 0.0, 1.0) * (n - 1.0);\n    float i = floor(t);\n    float f = t - i;\n    float s = clamp(softness, 0.0, 1.0);\n    float e = s > 0.0001 ? smoothstep(0.5 - 0.5 * s, 0.5 + 0.5 * s, f) : step(0.5, f);\n    return min(i + e, n - 1.0) / (n - 1.0);\n}\nfloat ukiyo_scanlines(float lineHeight, float speed) {\n    float y = gl_FragCoord.y / max(lineHeight, 1.0) + frame.screenParams.z * speed;\n    return 0.5 + 0.5 * cos(y * 6.2831853);\n}\n\nstruct SurfaceData {\n    vec3 baseColor;\n    float metallic;\n    float smoothness;\n    vec3 normal;\n    vec3 emission;\n    vec3 bakedLight;   // baked light multiplier; 1 when no bake is connected\n    float alpha;\n    float clearCoat;            // 0 = none (clear-coat layer strength)\n    float clearCoatSmoothness;  // clear-coat highlight sharpness\n    vec3 toonShade;     // Toon Master: shade colour in the shadow band\n    float toonThreshold;// Toon Master: N.L where the band starts\n    float toonSoftness; // Toon Master: width of the band edge\n    vec3 toonRamp;      // NPR Master: ramp atlas colour, multiplied into the shade\n    float toonOcclusion;// NPR Master: ambient occlusion (ILM green, vertex colour red)\n    float toonShadow;   // NPR Master: 1 where the sun is visible\n    float toonScene;    // NPR Master: 0 = no sun or sky term, the ramp carries the light\n    float toonRampBlend;//