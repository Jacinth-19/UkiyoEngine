        "surface": "struct SurfaceData {\n    vec3 baseColor;\n    float metallic;\n    float smoothness;\n    vec3 normal;\n    vec3 emission;\n    vec3 bakedLight;   // baked light multiplier; 1 when no bake is connected\n    float alpha;\n    float clearCoat;            // 0 = none (clear-coat layer strength)\n    float clearCoatSmoothness;  // clear-coat highlight sharpness\n    vec3 toonShade;     // Toon Master: shade colour in the shadow band\n    float toonThreshold;// Toon Master: N.L where the band starts\n    float toonSoftness; // Toon Master: width of the band edge\n    vec3 toonRamp;      // NPR Master: ramp atlas colour, multiplied into the shade\n    float toonOcclusion;// NPR Master: ambient occlusion (ILM green, vertex colour red)\n    float toonShadow;   // NPR Master: 1 where the sun is visible\n    float toonScene;    // NPR Master: 0 = no sun or sky term, the ramp carries the light\n    float toonRampBlend;// NPR Master: how strongly the ramp tone replaces the lit tone\n    float toonWrap;     // NPR Master: 0 = N.L terminator, 1 = half-Lambert\n    float toonMask;     // NPR Master: replaces the ramp (painted style ramp, ILM mask)\n    float toonMaskMix;  // NPR Master: how far toonMask replaces the ramp\n    float toonFloor;    // NPR Master: albedo floor kept in the shadow\n    float toonAmbient;  // NPR Master: hemisphere ambient strength\n    float toonBoost;    // NPR Master: multiplies the lit term\n    float toonNormalShade; // NPR Master: 0.92..1.08 lit modulation by the wrap\n    vec3 toonRim;       // Face Master: additive rim light\n    float toon;         // 1 = NPR (Toon) Master lighting\n    float sdfShadow;    // Hybrid/Face: 0 = lit, 1 = shadowed\n    float specMask;     // Hybrid: specular mask\n    vec3 hairSpecular;  // Hybrid: anisotropic hair\n    vec3 matcap;        // Hybrid: matcap reflection\n    float wetness;      // Hybrid: rain coverage\n    float hybrid;       // 1 = Hybrid Master lighting\n    float face;         // 1 = Face Master lighting\n    float lit;   // 1 = shaded by the frame's sun and sky, 0 = unlit\n};\n\nSurfaceData ukiyo_surface(vec2 uv, vec3 normal) {\n    SurfaceData s;\n    s.baseColor = vec3(1.0);\n    s.metallic = 0.0;\n    s.smoothness = 0.5;\n    s.normal = normal;\n    s.emission = vec3(0.0);\n    s.bakedLight = vec3(1.0);\n    s.alpha = 1.0;\n    s.clearCoat = 0.0;\n    s.clearCoatSmoothness = 0.5;\n    s.toonShade = vec3(0.6, 0.5, 0.6);\n    s.toonThreshold = 0.0;\n    s.toonSoftness = 0.05;\n    s.toonRamp = vec3(1.0);\n    s.toonOcclusion = 1.0;\n    s.toonShadow = 1.0;\n    s.toonScene = 1.0;\n    s.toonRampBlend = 1.0;\n    s.toonWrap = 0.0;\n    s.toonMask = 0.0;\n    s.toonMaskMix = 0.0;\n    s.toonFloor = 0.0;\n    s.toonAmbient = 0.55;\n    s.toonBoost = 1.0;\n    s.toonNormalShade = 0.0;\n    s.toonRim = vec3(0.0);\n    s.toon = 0.0;\n    s.sdfShadow = 0.0;\n    s.specMask = 1.0;\n    s.hairSpecular = vec3(0.0);\n    s.matcap = vec3(0.0);\n    s.wetness = 0.0;\n    s.hybrid = 0.0;\n    s.face = 0.0;\n    s.lit = 1.0;\n    vec2 n1_0 = uv;\n    vec3 n2_0 = texture(texn2, n1_0).rgb;\n    float n2_1 = texture(texn2, n1_0).a;\n    vec3 n3_0 = p3.xyz;\n    vec3 n4_0 = n2_0 * n3_0;\n    float n5_0 = p4.x;\n    vec2 n6_0 = vec2(clamp(dot(n4_0, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0), n5_0);\n    vec3 n7_0 = texture(texn7, n6_0).rgb;\n    float n7_1 = texture(texn7, n6_0).a;\n    vec3 n8_0 = n4_0 * n7_0;\n    float n9_0 = p5.x;\n    vec3 n10_0 = mix(n4_0, n8_0, n9_0);\n    vec3 n11_0 = p6.xyz;\n    vec3 n12_0 = vec3(1.0, 1.0, 1.0);\n    float n13_0 = 0.9;\n    float n14_0 = 1.0;\n    vec3 n15_0 = texture(texn15, n1_0).rgb;\n    float n15_1 = texture(texn15, n1_0).a;\n    float n16_0 = p7.x;\n    vec3 n17_0 = ukiyo_normal_map(n15_0, n16_0, normalize(normal), uv, v_world);\n    vec3 n18_0 = texture(texn18, n1_0).rgb;\n    float n18_1 = texture(texn18, n1_0).a;\n    float n19_0 = n18_0.r;\n    float n19_1 = n18_0.g;\n    float n19_2 = n18_0.b;\n    float n19_3 = n18_1;\n    vec3 n20_0 = v_color.rgb;\n    float n20_1 = v_color.a;\n    float n21_0 = n20_0.x;\n    float n21_1 = n20_0.y;\n    float n21_2 = n20_0.z;\n    float n22_0 = n19_1 * n21_0;\n    float n23_0 = p8.x;\n    float n24_0 = p9.x;\n    float n25_0 = p10.x;\n    float n26_0 = ukiyo_shadow_ramp_u(n17_0, n22_0, n23_0, n24_0, n25_0).x;\n    float n26_1 = ukiyo_shadow_ramp_u(n17_0, n22_0, n23_0, n24_0, n25_0).y;\n    float n27_0 = smoothstep(n13_0, n14_0, n26_0);\n    float n28_0 = p10.x;\n    float n29_0 = n27_0 * n28_0;\n    vec3 n30_0 = mix(n11_0, n12_0, n29_0);\n    float n31_0 = p11.x;\n    float n32_0 = p12.x;\n    vec2 n33_0 = ukiyo_spec_ramp_uv(n17_0, n18_1);\n    vec3 n34_0 = texture(texn34, n33_0).rgb;\n    float n34_1 = texture(texn34, n33_0).a;\n    vec3 n35_0 = texture(texn35, n1_0).rgb;\n    float n35_1 = texture(texn35, n1_0).a;\n    float n36_0 = n35_0.x;\n    float n36_1 = n35_0.y;\n    float n36_2 = n35_0.z;\n    vec3 n37_0 = n34_0 * n36_0;\n    float n38_0 = p13.x;\n    vec3 n39_0 = n37_0 * n38_0;\n    float n40_0 = n33_0.x;\n    float n40_1 = n33_0.y;\n    float n41_0 = 32.0;\n    float n42_0 = pow(n40_0, n41_0);\n    vec3 n43_0 = n39_0 * n42_0;\n    float n44_0 = 0.0;\n    float n45_0 = 1.0;\n    float n46_0 = 0.0;\n    float n47_0 = 1.0;\n    vec3 n48_0 = normalize(frame.sunDir.xyz);\n    float n49_0 = dot(n17_0, n48_0);\n    float n50_0 = clamp(n49_0, n46_0, n47_0);\n    float n51_0 = 0.2;\n    float n52_0 = n50_0 + n51_0;\n    float n53_0 = clamp(n52_0, n44_0, n45_0);\n    vec3 n54_0 = n43_0 * n53_0;\n    vec3 n55_0 = texture(texn55, n1_0).rgb;\n    float n55_1 = texture(texn55, n1_0).a;\n    vec3 n56_0 = p14.xyz;\n    vec3 n57_0 = n55_0 * n56_0;\n    float n58_0 = 0.0;\n    float n59_0 = 1.0;\n    float n60_0 = n55_0.x;\n    float n60_1 = n55_0.y;\n    float n60_2 = n55_0.z;\n    float n61_0 = n55_1 + n60_0;\n    float n62_0 = 0.35;\n    float n63_0 = n36_2 * n62_0;\n    float n64_0 = n61_0 + n63_0;\n    float n65_0 = clamp(n64_0, n58_0, n59_0);\n    float n66_0 = p15.x;\n    float n67_0 = n65_0 * n66_0;\n    vec3 n68_0 = n57_0 * n67_0;\n    vec3 n69_0 = n54_0 + n68_0;\n    vec3 n70_0 = p16.xyz;\n    float n71_0 = 0.0;\n    float n72_0 = 1.0;\n    vec3 n73_0 = normalize(frame.camPos.xyz - v_world);\n    float n74_0 = dot(n17_0, n73_0);\n    float n75_0 = clamp(n74_0, n71_0, n72_0);\n    float n76_0 = 1.0 - n75_0;\n    float n77_0 = p17.x;\n    float n78_0 = pow(n76_0, n77_0);\n    float n79_0 = p18.x;\n    float n80_0 = n78_0 * n79_0;\n    vec3 n81_0 = n70_0 * n80_0;\n    vec3 n82_0 = n69_0 + n81_0;\n    float n83_0 = p19.x;\n    float n84_0 = p20.x;\n    float n85_0 = 0.0;\n    float n86_0 = p20.x;\n    float n87_0 = step(n85_0, n86_0);\n    float n88_0 = mix(n15_1, n84_0, n87_0);\n    float n89_0 = p21.x;\n    float n90_0 = p22.x;\n    float n91_0 = p23.x;\n    float n92_0 = p24.x;\n    float n93_0 = p25.x;\n    float n94_0 = mix(mix(mix(mix(n93_0, n92_0, step(n88_0, 0.85)), n91_0, step(n88_0, 0.6)), n90_0, step(n88_0, 0.4)), n89_0, step(n88_0, 0.15));\n    float n95_0 = 10.0;\n    float n96_0 = p26.x;\n    float n97_0 = ukiyo_day_night(n96_0);\n    vec3 n98_0 = ukiyo_ramp_sample(texn98, n26_0, n94_0, n95_0, n97_0);\n    vec3 n99_0 = vec3(1.0, 1.0, 1.0);\n    vec3 n100_0 = mix(n98_0, n99_0, n26_1);\n    float n101_0 = p27.x;\n    float n102_0 = 1.0;\n    float n103_0 = p28.x;\n    float n104_0 = p29.x;\n    float n105_0 = p30.x;\n    float n106_0 = 1.0;\n    float n107_0 = 0.92;\n    float n108_0 = 1.08;\n    float n109_0 = 0.5;\n    float n110_0 = n50_0 * n109_0;\n    float n111_0 = 0.5;\n    float n112_0 = n110_0 + n111_0;\n    float n113_0 = p31.x;\n    float n114_0 = mix(n50_0, n112_0, n113_0);\n    float n115_0 = mix(n107_0, n108_0, n114_0);\n    float n116_0 = p32.x;\n    float n117_0 = mix(n106_0, n115_0, n116_0);\n    float n118_0 = p33.x;\n    float n119_0 = n117_0 * n118_0;\n    s.baseColor = n10_0;\n    s.toonShade = n30_0;\n    s.toonThreshold = n31_0;\n    s.toonSoftness = n32_0;\n    s.normal = n17_0;\n    s.emission = n82_0;\n    s.alpha = n83_0;\n    s.toonRamp = n100_0;\n    s.toonOcclusion = 1.0;\n    s.toonShadow = 1.0;\n    s.toonScene = n101_0;\n    s.toonWrap = n102_0;\n    s.toonMask = n15_1;\n    s.toonMaskMix = n103_0;\n    s.toonRampBlend = n104_0;\n    s.toonFloor = n105_0;\n    s.toonAmbient = 0.55;\n    s.toonBoost = n119_0;\n    s.toonNormalShade = 0.0;\n    s.toon = 1.0;\n    return s;\n}\n",
