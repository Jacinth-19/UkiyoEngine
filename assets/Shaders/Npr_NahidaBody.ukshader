thstep(0.3 + offset - edge, 0.3 + offset + edge,\n                                    pow(clamp(ndl, 0.0, 1.0) * 0.5 + 0.5, 2.0)), 0.003, 0.997);\n    if (kaze < 0.5) return vec2(legacy, 0.0);\n    float kazeAo = clamp(ao, 0.0, 1.0);\n    float s = clamp(2.0 * (ndl * 0.5 + 0.5) * kazeAo, 0.0, 1.0);\n    s = mix(s, 1.0, step(0.9, kazeAo));\n    float top = 0.5 + offset;\n    return vec2(clamp(smoothstep(top - edge, top, s), 0.003, 0.997), step(top, s));\n}\nvec2 ukiyo_spec_ramp_uv(vec3 N, float style) {\n    vec3 V = normalize(frame.camPos.xyz - v_world);\n    vec3 H = normalize(normalize(frame.sunDir.xyz) + V);\n    return vec2(clamp(dot(normalize(N), H), 0.0, 1.0), style);\n}\nlayout(set = 1, binding = 4) uniform sampler2D texn34;\nlayout(set = 1, binding = 5) uniform sampler2D texn35;\nlayout(set = 1, binding = 6) uniform sampler2D texn55;\nfloat ukiyo_day_night(float dayOverride) {\n    if (dayOverride < 0.0) return (normalize(frame.sunDir.xyz).y + 1.0) * 0.5;\n    return clamp(dayOverride, 0.0, 1.0);\n}\nlayout(set = 1, binding = 7) uniform sampler2D texn98;\nvec3 ukiyo_ramp_sample(sampler2D rampTex, float u, float row, float rows, float day) {\n    float v = (row - 0.5) / max(rows, 1.0);\n    float cu = clamp(u, 0.003, 0.997);\n    return mix(texture(rampTex, vec2(cu, v + 0.5)).rgb, texture(rampTex, vec2(cu, v)).rgb,\n             clamp(day, 0.0, 1.0));\n}\n\nstruct SurfaceData {\n    vec3 baseColor;\n    float metallic;\n    float smoothness;\n    vec3 normal;\n    vec3 emission;\n    vec3 bakedLight;   // baked light multiplier; 1 when no bake is connected\n    float alpha;\n    float clearCoat;            // 0 = none (clear-coat layer strength)\n    float clearCoatSmoothness;  // clear-coat highlight sharpness\n    vec3 toonShade;     // Toon Master: shade colour in the shadow band\n    float toonThreshold;// Toon Master: N.L where the band starts\n    float toonSoftness; // Toon Master: width of the band edge\n    vec3 toonRamp;      // NPR Master: ramp atl