  "note": "Personal test only. Own implementation. Channel and exposure view for the Endfield textures.",
  "compiled": {
    "ok": true,
    "fragment": "#version 450\n// Generated by tools/endfield/build_endfield.py from EndfieldDebug.body.glsl. Edit the body file, then re-run.\nlayout(location = 0) in vec2 v_uv;\nlayout(location = 1) in vec3 v_normal;\nlayout(location = 2) in vec3 v_world;\nlayout(location = 3) in vec4 v_color;\nlayout(location = 4) in vec2 v_uv1;\nlayout(location = 0) out vec4 o_color;\nlayout(set = 0, binding = 0, std140) uniform FrameBlock {\n    mat4 view;\n    mat4 proj;\n    mat4 viewProj;\n    mat4 invViewProj;\n    mat4 shadowMatrix[3];\n    vec4 camPos;\n    vec4 sunDir;\n    vec4 sunColor;\n    vec4 skyColor;\n    vec4 groundColor;\n    vec4 cascadeSplits;\n    vec4 shadowParams;\n    vec4 screenParams;\n    vec4 pointPos[4];\n    vec4 pointColor[4];\n    vec4 toonA;\n    vec4 toonB;\n    vec4 toonC;\n    vec4 toonD;\n    vec4 toonE;\n    vec4 toonF;\n    vec4 toonG;\n    vec4 toonH;\n    vec4 toonI;\n    vec4 waterArea;\n    vec4 waterHalf;\n    vec4 waterShallow;\n    vec4 waterDeep;\n    vec4 waterWaveD[4];\n    vec4 waterWaveS[4];\n} frame;\nlayout(set = 0, binding = 1) uniform sampler2D uShadowMap;\n\nlayout(set = 1, binding = 15, std140) uniform UkMaterial {\n    vec4 p0; // channel (float)\n    vec4 p1; // exposure (float)\n};\n\n#define P_channel p0.x\n#define P_exposure p1.x\n\nlayout(set = 1, binding = 0) uniform sampler2D tex_main;\n\nfloat shadowFactor(vec3 worldPos, vec3 N) {\n    if (frame.shadowParams.x < 0.5) return 1.0;\n    vec3 L = normalize(frame.sunDir.xyz);\n    float viewDist = -(frame.view * vec4(worldPos, 1.0)).z;\n    int cascade = -1;\n    if (viewDist < frame.cascadeSplits.x) cascade = 0;\n    else if (viewDist < frame.cascadeSplits.y) cascade = 1;\n    else if (viewDist < frame.cascadeSplits.z) cascade = 2;\n    if (cascade < 0) return 1.0;\n    float ndl = clamp(dot(N, L), 0.0, 1.0);\n    vec3 p = worldPos + N * frame.shadowParams.z * (1.0 - ndl);\n    vec4 lp = frame.shadowMatrix[cascade] * vec4(p, 1.0);\n    vec3 sc = lp.xyz / lp.w;\n    vec2 uv = sc.xy * 0.5 + 0.5;\n    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return 1.0;\n    vec2 quad = vec2(float(cascade % 2), float(cascade / 2)) * 0.5;\n    uv = clamp(quad + uv * 0.5, quad + vec2(0.001), quad + vec2(0.499));\n    float texel = frame.shadowParams.y;\n    float z = sc.z - frame.shadowParams.w;\n    vec4 g0 = textureGather(uShadowMap, uv + vec2(-0.5, -0.5) * texel);\n    vec4 g1 = textureGather(uShadowMap, uv + vec2( 0.5, -0.5) * texel);\n    vec4 g2 = textureGather(uShadowMap, uv + vec2(-0.5,  0.5) * texel);\n    vec4 g3 = textureGather(uShadowMap, uv + vec2( 0.5,  0.5) * texel);\n    float lit = dot(step(vec4(z), g0), vec4(1.0)) + dot(step(vec4(z), g1), vec4(1.0))\n              + dot(step(vec4(z), g2), vec4(1.0)) + dot(step(vec4(z), g3), vec4(1.0));\n    return lit / 16.0;\n}\n\n\n// Endfield debug view: shows one channel of the main texture, scaled by exposure.\n// channel: 0 RGB, 1 R, 2 G, 3 B, 4 A (as grey), 5 UV (u, v, 0).\n\nvoid main() {\n    vec4 c = texture(tex_main, v_uv);\n    int ch = int(P_channel + 0.5);\n    vec3 out3 = c.rgb;\n    if (ch == 1) out3 = vec3(c.r);\n    else if (ch == 2) out3 = vec3(c.g);\n    else if (ch == 3) out3 = vec3(c.b);\n    else if (ch == 4) out3 = vec3(c.a);\n    else if (ch == 5) out3 = vec3(fract(v_uv), 0.0);\n    o_color = vec4(clamp(out3 * P_exposure, 0.0, 1.0), c.a);\n}\n",
