        "fragment": "#version 450\n// Generated by the Ukiyo Shader Graph. Do not edit by hand.\nlayout(location = 0) in vec2 v_uv;\nlayout(location = 1) in vec3 v_normal;\nlayout(location = 2) in vec3 v_world;\nlayout(location = 0) out vec4 o_color;\nlayout(set = 0, binding = 0, std140) uniform FrameBlock {\n    mat4 view;\n    mat4 proj;\n    mat4 viewProj;\n    mat4 invViewProj;\n    mat4 shadowMatrix[3];\n    vec4 camPos;\n    vec4 sunDir;\n    vec4 sunColor;\n    vec4 skyColor;\n    vec4 groundColor;\n    vec4 cascadeSplits;\n    vec4 shadowParams;\n    vec4 screenParams;   // z = time (s)\n    vec4 pointPos[4];\n    vec4 pointColor[4];\n} frame;\nlayout(set = 1, binding = 15, std140) uniform UkMaterial {\n    vec4 p0; // baseColor (vec3)\n    vec4 p1; // metallic (float)\n    vec4 p2; // smoothness (float)\n    vec4 p3; // glowColor (vec3)\n    vec4 p4; // edgeWidth (float)\n    vec4 p5; // dissolve (float)\n    vec4 p6; // glowStrength (float)\n};\n\nstruct SurfaceData {\n    vec3 baseColor;\n    float metallic;\n    float smoothness;\n    vec3 normal;\n    vec3 emission;\n    vec3 bakedLight;   // baked light multiplier; 1 when no bake is connected\n    float alpha;\n    float clearCoat;            // 0 = none (clear-coat layer strength)\n    float clearCoatSmoothness;  // clear-coat highlight sharpness\n    float lit;   // 1 = shaded by the frame's sun and sky, 0 = unlit\n};\n\nSurfaceData ukiyo_surface(vec2 uv, vec3 normal) {\n    SurfaceData s;\n    s.baseColor = vec3(1.0);\n    s.metallic = 0.0;\n    s.smoothness = 0.5;\n    s.normal = normal;\n    s.emission = vec3(0.0);\n    s.bakedLight = vec3(1.0);\n    s.alpha = 1.0;\n    s.clearCoat = 0.0;\n    s.clearCoatSmoothness = 0.5;\n    s.lit = 1.0;\n    vec3 n1_0 = p0.xyz;\n    float n2_0 = p1.x;\n    float n3_0 = p2.x;\n    vec3 n4_0 = p3.xyz;\n    float n5_0 = p4.x;\n    float n6_0 = -1.0;\n    float n7_0 = n5_0 * n6_0;\n    float n8_0 = 0.0;\n    vec3 n9_0 = v_world;\n    float n10_0 = n9_0.x;\n    float n10_1 = n9_0.y;\n    float n10_2 = n9_0.z;\n    float n11_0 = 1.5;\n    float n12_0 = n10_1 + n11_0;\n    float n13_0 = p5.x;\n    float n14_0 = -3.0;\n    float n15_0 = n13_0 * n14_0;\n    float n16_0 = n12_0 + n15_0;\n    float n17_0 = smoothstep(n7_0, n8_0, n16_0);\n    float n18_0 = 0.0;\n    float n19_0 = smoothstep(n18_0, n5_0, n16_0);\n    float n20_0 = -1.0;\n    float n21_0 = n19_0 * n20_0;\n    float n22_0 = n17_0 + n21_0;\n    float n23_0 = p6.x;\n    float n24_0 = n22_0 * n23_0;\n    vec3 n25_0 = vec3(n24_0, n24_0, n24_0);\n    vec3 n26_0 = n4_0 * n25_0;\n    s.baseColor = n1_0;\n    s.metallic = n2_0;\n    s.smoothness = n3_0;\n    s.normal = normal;\n    s.emission = n26_0;\n    s.alpha = n17_0;\n    return s;\n}\n\nvoid main() {\n    SurfaceData s = ukiyo_surface(v_uv, normalize(v_normal));\n    vec3 color = s.baseColor * s.bakedLight + s.emission;\n    if (s.lit > 0.5) {\n        vec3 N = normalize(s.normal);\n        float ndl = max(dot(N, normalize(frame.sunDir.xyz)), 0.0);\n        vec3 hemi = mix(frame.groundColor.rgb, frame.skyColor.rgb, 0.5 + 0.5 * N.y);\n        // Blinn-Phong highlight: metallic tints F0, smoothness sets the exponent.\n        vec3 V = normalize(frame.camPos.xyz - v_world);\n        vec3 H = normalize(normalize(frame.sunDir.xyz) + V);\n        float shin = exp2(1.0 + 10.0 * s.smoothness);\n        float spec = pow(max(dot(N, H), 0.0), shin) * (shin + 8.0) / 25.13274;\n        vec3 F0 = mix(vec3(0.04), s.baseColor, s.metallic);\n        vec3 diffuse = s.baseColor * (1.0 - s.metallic) * (frame.sunColor.rgb * ndl + hemi);\n        color = diffuse + F0 * frame.sunColor.rgb * spec * step(0.0, ndl) + s.emission;\n        // Clear coat: a sharper white highlight over the base; it also dims the base by its Fresnel.\n        float ccExp = exp2(1.0 + 10.0 * s.clearCoatSmoothness);\n        float ccSpec = pow(max(dot(N, H), 0.0), ccExp) * (ccExp + 8.0) / 25.13274;\n        color = color * (1.0 - 0.04 * s.clearCoat) + frame.sunColor.rgb * ccSpec * s.clearCoat * step(0.0, ndl);\n    }\n    o_color = vec4(color, s.alpha);\n}\n",
