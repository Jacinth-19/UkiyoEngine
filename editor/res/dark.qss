/* Ukiyo World Editor theme, modelled on the Unity Editor dark skin.
   Panels #282828, headers #303030, fields #1d1d1d, selection #2c5d87, accent #4a9ef0. */

QWidget { background-color: #282828; color: #c4c4c4; font-size: 12px; selection-background-color: #2c5d87; selection-color: #ffffff; }
QMainWindow { background: #1f1f1f; }
QMainWindow::separator { background: #1a1a1a; width: 2px; height: 2px; }
QMainWindow { background: #1a1a1a; }   /* gaps between docks and the central view take the divider colour */
QToolTip { background: #1d1d1d; color: #d0d0d0; border: 1px solid #111111; padding: 4px; }

/* Menu bar and menus */
QMenuBar { background: #2b2b2b; border-bottom: 1px solid #1a1a1a; padding: 2px 4px; }
QMenuBar::item { padding: 4px 8px; background: transparent; }
QMenuBar::item:selected { background: #3a3a3a; }
QMenu { background: #2b2b2b; border: 1px solid #111111; padding: 4px 0; }
QMenu::item { padding: 5px 24px 5px 10px; }
QMenu::item:selected { background: #2c5d87; color: #ffffff; }
QMenu::separator { height: 1px; background: #3a3a3a; margin: 4px 8px; }

/* Playback toolbar: centred play controls, flat tool buttons */
QToolBar#playbackToolbar { background: #2b2b2b; border: none; border-bottom: 1px solid #1a1a1a; spacing: 4px; padding: 3px 6px; }
QToolBar::separator { width: 1px; background: #444444; margin: 4px 6px; }
QPushButton#playButton, QPushButton#pauseButton { min-width: 34px; max-width: 34px; min-height: 22px; max-height: 22px; padding: 2px; background: #3a3a3a; border: 1px solid #1a1a1a; border-radius: 3px; }
QPushButton#playButton:hover, QPushButton#pauseButton:hover { background: #454545; }
QPushButton#playButton:checked { background: #2c5d87; border-color: #1f4566; }
QPushButton#pauseButton:checked { background: #555555; border-color: #3c3c3c; }
QPushButton#toolButton, QToolButton#toolButton { background: transparent; border: 1px solid transparent; border-radius: 3px; padding: 3px; min-width: 22px; min-height: 22px; }
QPushButton#toolButton:hover, QToolButton#toolButton:hover { background: #3a3a3a; border-color: #1a1a1a; }
QPushButton#toolButton:pressed, QToolButton#toolButton:pressed { background: #2c2c2c; }

/* Buttons */
QPushButton { background: #3a3a3a; border: 1px solid #1a1a1a; border-radius: 3px; padding: 4px 10px; min-height: 18px; }
QPushButton:hover { background: #444444; }
QPushButton:pressed { background: #2e2e2e; }
QPushButton:disabled { color: #6a6a6a; background: #303030; }
QPushButton#consoleButton { padding: 3px 8px; }

/* Dock panels: Unity-style header bar (dockHeader) above each panel */
QDockWidget { color: #c4c4c4; }
QWidget#dockHeader { background: #2b2b2b; border-top: 1px solid #3a3a3a; border-bottom: 1px solid #1a1a1a; }
QLabel#dockTitle { background: transparent; font-weight: bold; color: #d4d4d4; }
QLabel#dockIcon { background: transparent; }

/* Tabs (Scene/Game in the centre, and the docked panel tabs) */
QTabWidget#viewTabs::pane { border: none; margin: 0px; padding: 0px; background: #1f1f1f; }
QTabWidget#viewTabs, QTabWidget#viewTabs > QStackedWidget { background: #1a1a1a; }
RenderView { background: #1a1a1a; }   /* the view label shows this where the frame is one pixel narrower */   /* the 1 px gap beside the viewport takes the divider colour */
QTabBar { background: #2b2b2b; }
QTabBar::tab { background: #2b2b2b; color: #a8a8a8; padding: 5px 12px; border: none; border-top: 2px solid transparent; margin-right: 1px; min-width: 60px; }
QTabBar::tab:selected { background: #3a3a3a; color: #e6e6e6; border-top: 2px solid #4a9ef0; }
QTabBar::tab:hover:!selected { background: #333333; color: #d0d0d0; }
QTabWidget::pane { border: none; }

/* Scene and Game render views */
QLabel#viewport, QLabel#preview { background: #1d2024; color: #7a8290; }

/* Inspector */
QScrollArea { background: #282828; border: none; }
QScrollArea#inspector { background: #282828; }
QWidget#inspectorHeader { background: #2e2e2e; border-bottom: 1px solid #1a1a1a; }
QLabel#inspectorTitle { font-size: 14px; font-weight: bold; color: #e6e6e6; background: transparent; }
QToolButton#foldoutHeader { background: #333333; border: none; border-top: 1px solid #3c3c3c; border-bottom: 1px solid #1f1f1f; text-align: left; padding: 5px 8px; font-weight: bold; color: #d4d4d4; }
QToolButton#foldoutHeader:hover { background: #3a3a3a; }
QLabel#hint { color: #8c8c8c; font-style: italic; }
QLabel#fieldLabel { color: #a8a8a8; }

/* Form fields */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    background: #1d1d1d; border: 1px solid #111111; border-radius: 2px; padding: 2px 6px; min-height: 18px; color: #d8d8d8;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus { border-color: #4a9ef0; }
QComboBox::drop-down { width: 16px; border-left: 1px solid #111111; background: #333333; }
QComboBox QAbstractItemView { background: #1d1d1d; border: 1px solid #111111; selection-background-color: #2c5d87; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QSpinBox::up-button, QSpinBox::down-button { width: 14px; background: #333333; border-left: 1px solid #111111; }
QCheckBox { spacing: 6px; background: transparent; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid #111111; background: #1d1d1d; border-radius: 2px; }
QCheckBox::indicator:checked { background: #2c5d87; border-color: #1f4566; }

/* Project browser: folder tree, thumbnail grid, details */
QTreeView, QTreeWidget, QListView, QListWidget, QPlainTextEdit {
    background: #232323; border: 1px solid #1a1a1a; alternate-background-color: #282828; outline: none;
}
QTreeView::item, QTreeWidget::item { padding: 2px 2px; min-height: 18px; }
QTreeView::item:hover, QTreeWidget::item:hover, QListView::item:hover, QListWidget::item:hover { background: #303030; }
QTreeView::item:selected, QTreeWidget::item:selected, QListView::item:selected, QListWidget::item:selected { background: #2c5d87; color: #ffffff; }
QListView#projectGrid { background: #232323; }
QListView#projectGrid::item { padding: 4px; border-radius: 3px; color: #c4c4c4; }
QListView#projectGrid::item:selected { background: #2c5d87; }
QWidget#browserBar { background: #2b2b2b; border-bottom: 1px solid #1a1a1a; }
/* Game tab bar: same surface as the game view, so the strip reads as part of the view. */
QWidget#gameBar { background: #1d2024; border-bottom: 1px solid #1a1a1a; }
QLabel#breadcrumb { color: #a8a8a8; background: transparent; }
QWidget#detailsPane { background: #2a2a2a; border-left: 1px solid #1a1a1a; }
QLabel#detailPreview { background: #1d1d1d; border: 1px solid #111111; border-radius: 4px; padding: 6px; }
QLabel#detailTitle { font-size: 13px; font-weight: bold; color: #e6e6e6; background: transparent; }
QLabel#detailText { color: #a8a8a8; background: transparent; font-size: 11px; line-height: 150%; }
QSplitter::handle { background: #1a1a1a; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }

/* Animation window */
QWidget#animationPage { background: #282828; }
QLabel#timeLabel { font-family: "DejaVu Sans Mono", monospace; color: #a8a8a8; background: transparent; }
QWidget#consolePage { background: #282828; }
QPlainTextEdit#console, QListWidget#console { font-family: "DejaVu Sans Mono", monospace; font-size: 11px; color: #cfd4da; }
QToolButton#consoleLevel { background: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px 6px; color: #c4c4c4; }
QToolButton#consoleLevel:checked { background: #3a3a3a; border-color: #1a1a1a; }
QToolButton#consoleLevel:hover { background: #333333; }

/* Tables and headers */
QHeaderView::section { background: #303030; border: none; border-right: 1px solid #1a1a1a; padding: 3px; }

/* Scroll bars */
QScrollBar:vertical { background: #232323; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #232323; height: 12px; margin: 0; }
QScrollBar::handle:vertical { background: #484848; border-radius: 4px; min-height: 24px; margin: 2px; }
QScrollBar::handle:horizontal { background: #484848; border-radius: 4px; min-width: 24px; margin: 2px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #5a5a5a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* Sliders (timeline and thumbnail size) */
QSlider::groove:horizontal { background: #1d1d1d; height: 4px; border-radius: 2px; border: 1px solid #111111; }
QSlider::sub-page:horizontal { background: #4a9ef0; border-radius: 2px; }
QSlider::handle:horizontal { background: #d8d8d8; width: 10px; margin: -6px 0; border-radius: 5px; }
QSlider::handle:horizontal:hover { background: #ffffff; }

/* Status bar */
QStatusBar { background: #2b2b2b; border-top: 1px solid #1a1a1a; color: #9a9a9a; font-size: 11px; }
QStatusBar::item { border: none; }
